{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b41bf2c7f42940e99587095afdcffe54",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RevealUsingColor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1287.2000732421875,
            "y": 752.7999267578125,
            "width": 256.800048828125,
            "height": 325.60009765625
        }
    },
    "m_Slots": [
        {
            "m_Id": "579ddc3fa4b944f69414f61f08e3d35b"
        },
        {
            "m_Id": "de515ec4ae6c43b986654d72328d30e4"
        },
        {
            "m_Id": "cbf2481447ef494faf456d9b00ce93e8"
        },
        {
            "m_Id": "f69fdc155f0049f6999ec45fd09b5be9"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "RevealUsingColor",
    "m_FunctionSource": "9ea41c5e7de10c24d921de2f5f6c58fd",
    "m_FunctionBody": "// By Color\r\n// e.g. To only reveal decals with roughly magenta/purple lights could use Color = (1,0,1) and Range = 0.5\r\n\r\nvoid RevealUsingColor_float(float3 WorldPosition, float4 Color, float Range, out float Out){\r\n    half4 Shadowmask = half4(1,1,1,1);\r\n    float totalAtten = 0;\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    InputData inputData = (InputData)0;\r\n    float4 screenPos = ComputeScreenPos(TransformWorldToHClip(WorldPosition));\r\n    inputData.normalizedScreenSpaceUV = screenPos.xy / screenPos.w;\r\n    inputData.positionWS = WorldPosition;\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        Light light = GetAdditionalLight(lightIndex, WorldPosition, Shadowmask);\r\n        float intensity = length(light.color.rgb);\r\n        float atten = intensity * light.distanceAttenuation * light.shadowAttenuation;\r\n        bool LightShouldReveal = distance(normalize(light.color.rgb), Color.rgb) < Range;\r\n        totalAtten += LightShouldReveal ? atten : 0;\r\n    LIGHT_LOOP_END\r\n#endif\r\n    Out = totalAtten;\r\n}"
}

